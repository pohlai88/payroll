# Copied to `.env.local` for local work. `npm run dev:api` and
# `scripts/invite-user.ts` load `.env.local` when present (shell env wins).

# Local Docker Postgres (see docker-compose.yml) or Neon pooled URL
DATABASE_URL=postgres://payroll:payroll@localhost:54329/payroll

# Neon Auth (Managed Better Auth) — from Neon Console → Auth
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Optional API process
# PORT=8787
# Comma-separated origins OK (Vite may bind :5174 when :5173 is taken)
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Optional third-party countersignature of the closure manifest (RFC 3161).
# Every closed run is sealed and chained regardless — this only adds an outside
# witness, and unset (the default for tests and local work) means no network
# call at all. The seal panel in the SPA shows the current setting.
# DigiCert's free service is audited but not recognised under the Digital
# Signature Act 1997; for the statutory presumption use an MCMC-recognised
# date/time stamp service (Pos Digicert, MSC Trustgate) — same variable.
# TSA_URL=http://timestamp.digicert.com

# Cloudflare R2 (Phase 6–7 artifacts) — all five required together when set
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=clarity-payroll-artifacts
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Phase 4A SPA (Vite) — placeholders only; copy into `.env.local`
# Register http://localhost:5173 as a Neon Auth trusted origin.
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth
VITE_API_BASE=http://localhost:8787

# Optional: Developer login (Neon Auth password ≥ 8). Bootstrap both IdP + app invite:
#   npx tsx scripts/setup-dev-user.ts --email dev@example.com --name "Dev User" --password 'dev123456' --system-admin
# VITE_DEV_EMAIL=dev@example.com
# VITE_DEV_PASSWORD=dev123456
