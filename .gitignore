# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
# npm install / npm ci → node_modules/
node_modules/
# Accidental package-manager swaps leave a renamed tree; never commit it.
node_modules.trash/
# This repo is npm-only (see packageManager + scripts/ensure-npm.cjs).
pnpm-lock.yaml
yarn.lock
bun.lock
bun.lockb

# ---------------------------------------------------------------------------
# Build outputs
# ---------------------------------------------------------------------------
# vite build → dist/ (default outDir)
dist/
# vercel CLI / deploy scratch
.vercel/

# ---------------------------------------------------------------------------
# Caches (safe to delete; regenerated by tools)
# ---------------------------------------------------------------------------
# tsc --noEmit / npm run typecheck / npm run build → tmp/tsconfig.tsbuildinfo
# (configured via tsconfig compilerOptions.tsBuildInfoFile)
*.tsbuildinfo
tmp/
# Generic tool caches if introduced later
.cache/
# vitest / coverage reporters
coverage/

# ---------------------------------------------------------------------------
# Local secrets & machine-specific tooling
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# neon CLI project link (neon link / neon projects) → .neon
.neon

# ---------------------------------------------------------------------------
# Process / agent scratch written at repo root
# ---------------------------------------------------------------------------
# Detached or redirected Vite/API runs, e.g.
#   npm run dev > .vite-dev.out.log 2> .vite-dev.err.log
*.log
.vite-dev.*.log
# Ad-hoc Biome/Ultracite JSON dumps from agents/CI probes
tmp-*.json
biome-check-out.json

# ---------------------------------------------------------------------------
# Local infrastructure scratch
# ---------------------------------------------------------------------------
# docker-compose named volumes / bind mounts if used outside tmpfs
.docker-data/
# Legacy v1 SQLite path (authoritative archive is outside this repo)
data/
# Wrangler local state / R2 simulation
.wrangler/

# Extracted text from official PDFs (binaries under db/evidence/ are kept)
db/evidence/*.txt

# Brainstorm preview servers (pid/token/HTML scratch)
.superpowers/brainstorm/

# ---------------------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local wrangler/R2 probe leftovers
runs/

